{
  "manifest_version": 3,
  "name": "Gmail Inline PGP - Instant Keys",
  "version": "1.1",
  "description": "Inject Encrypt/Sign buttons into Gmail and manage PGP keys.",
  "permissions": [
    "scripting",
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://mail.google.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["openpgp.min.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["openpgp.min.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
